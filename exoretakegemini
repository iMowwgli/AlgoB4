def find_level_with_max_nodes(B):
    if B == None:
        return -1
    else:
        q = Queue()
        q.enqueue(B)
        curr_lvl = 0   
        best_lvl = 0   
        max_nodes = 0

        while not q.isempty():
            qnxt = Queue()
            node_lvl = 0
            
            while not q.isempty():
                x = q.dequeue()
                node_lvl +=1 
                
                if x.left != None:
                    qnxt.enqueue(x.left)
                if x.right != None:
                    qnxt.enqueue(x.right)
                
            if node_lvl > max_nodes:
                max_nodes = node_lvl
                best_lvl = curr_lvl
            
            q = qnxt
            curr_lvl += 1
            
        return best_lvl


