'''1. Profondeur — D1 : size(B)
Le but est de compter le nombre total de nœuds dans l'arbre.'''

def size(B):
    if B == None:
        return 0
    else:
        return 1 + size(B.left) + size(B.right)
    
def largeur(B):
    if B == None:
        return []
    else:
        q = Queue()
        q.enqueue(B)
        res = []
        while not q.isempty():
            
            x = q.dequeue()

            res.append(x.key)
            
            if x.left != None:
                q.enqueue(x.left)
            if x.right != None:
                q.enqueue(x.right)
        
    return res 

def hauteur(B):
    if B == None:
        return -1
    else:
        return 1 + max(hauteur(B.left),hauteur(B.right)) 


def size_bfs(B):
    if B == None:
        return 0
    else:
        q = Queue()
        q.enqueue(B)
        res = 0

        while not q.isempty():

            x = q.dequeue()
            res += 1

            if x.left != None:
                q.enqueue(x.left)
            if x.right != None:
                q.enqueue(x.right)
        
    return res 

'''D3 : Les 3 ordres (Préfixe, Infixe, Suffixe)

Écris 3 fonctions séparées qui affichent (ou retournent une liste) des clés. 
Le secret réside uniquement dans la place du print(B.key) ou de 
l'ajout par rapport aux deux appels récursifs

'''

def prefixe(B):
    if B == None:
        return []
    return [B.key] + prefixe(B.left) + prefixe(B.right)

def infixe(B):
    if B == None:
        return []
    return infixe(B.left) + [B.key] + infixe(B.right)

def suffixe(B):
    if B == None:
        return []
    return suffixe(B.left) + suffixe(B.right) + [B.key]

'''B3 object_to_list(B)
Pour cet exercice, on veut transformer l'arbre en une liste où chaque élément est placé à son indice hiérarchique.'''


def object_to_list(B):
    if B == None:
        return []
    
    q = Queue()
    # On enfile le premier couple : (le nœud de la racine, son index qui est 1)
    q.enqueue((B, 1)) 
    
    # On initialise notre liste de résultat avec une taille de départ
    res = [None] * 2 
    
    while not q.isempty():
        # On extrait le couple
        current, idx = q.dequeue()
        
        # 1. Si 'idx' est plus grand que la taille de 'res', 
        #    il faut agrandir 'res' avec des [None]
        if idx >= len(res):
            res = res + [None] * (idx - len(res) + 1)
            
        # 2. On place la clé du nœud au bon endroit
        res[idx] = current.key
        
        # 3. On enfile les fils avec leurs indices hiérarchiques
        if current.left != None:
            q.enqueue((current.left, 2 * idx))
        if current.right != None:
            q.enqueue((current.right, 2 * idx + 1))
            
    return res


def count_leaves(B):
    if B == None:
        return 0
    
    if B.left == None and B.right == None:
        return 1
    
    return count_leaves(B.left) + count_leaves(B.right)

def sum_tree(B):
    if  B == None:
        return 0
    else:
        return B.key + sum_tree(B.left) + sum_tree(B.right)
        
def check_sum(B):
    if B == None:
        return True
    
    if B.left != None and B.right != None:
        cond= (B.key == B.left.key + B.right.key)
    else:
        # Si c'est une feuille ou un point simple, il n'y a pas de violation
        cond = True
        
    # 2. Grâce au "and", si condition_ici est False, 
    # la machine s'arrête direct (court-circuit) et renvoie False.
    return cond and check_sum(B.left) and check_sum(B.right)


'''Écrire la fonction get_first_single(B) qui retourne laclé du premier point simple rencontré dans l arbre
binaire B et -1 si B ne contient pas de point simple (l arbre binaire B ne contient que des entiers positifs).Le
parcours profondeur doit obligatoirement être utilisé.'''

def get_first_single(B):
    if B == None:
        return -1 
    else:
        if B.left == None:
            if B.right != None:
                return B.key
        elif B.left != None:
            if B.right == None:
                return B.key
        # 2. Si on arrive ici, c'est un point double. On explore d'abord à gauche.
        res_left = get_first_single(B.left)
        if res_left != -1:
            return res_left # Court-circuit immédiat ! Trouvé à gauche, on ne va pas à droite.
            
        # 3. Si rien n'a été trouvé à gauche, on renvoie le résultat de droite
        return get_first_single(B.right)

'''Écrire la fonction get_first_heavy_double(B) qui renvoie la clé du premier point double (un nœud avec 2 enfants) 
rencontré lors d'un parcours en profondeur (DFS, fils gauche d'abord) dont la clé est strictement supérieure à la 
somme des clés de ses deux fils directs. 
Si aucun nœud ne respecte cette condition ou s'il n'y a pas de point double, la fonction doit renvoyer -1'''

def get_first_heavy_double(B):
    if B == None:
        return -1
    else:
        if B.left != None:
            if B.right != None:
                children = B.left.key + B.right.key
                if B.key > children:
                    return B.key
        
        res_left = get_first_heavy_double(B.left)
        if res_left != -1:
            return res_left
        
        return get_first_heavy_double(B.right)
        

