        q = Queue()
        q.enqueue(B)
        ex = 1

        while not q.isempty():
            t_lvl = len(q)
            qnxt = Queue()
            while not q.isempty():
                x = q.dequeue()
                if x.left != None:
                    qnxt.enqueue(x.left)
                if x.right != None:
                    qnxt.enqueue(x.right)
            
            if t_lvl != ex:
                if not qnxt.isempty():
                    return False
            ex*=2
            q = qnxt

        return True 

