def replace_single_by_child_sum(B):
    if B == None:
        return None
    else:
        # 1. TRAITEMENT SUFFIXE : On transforme d'abord les sous-arbres
        new_left = replace_single_by_child_sum(B.left)
        new_right = replace_single_by_child_sum(B.right)
        
        # 2. TEST LOCAL : On analyse la structure pour reconstruire le nœud
        if new_left == None:
            if new_right == None:
                # Cas A : Feuille (0 fils) -> On garde la clé d'origine
                return BinTree(B.key, None, None)
            else:
                # Cas B : Point simple avec fils DROIT unique -> Clé du fils droit
                return BinTree(new_right.key, None, new_right)
        else:
            if new_right == None:
                # Cas C : Point simple avec fils GAUCHE unique -> Clé du fils gauche
                return BinTree(new_left.key, new_left, None)
            else:
                # Cas D : Le nœud a 2 fils -> On garde la clé d'origine
                return BinTree(B.key, new_left, new_right)

def find_max_by_level(B):
    if B == None:
        return []
    else:
        q = Queue()
        q.enqueue(B)
        
        res = []
        while not q.isempty():
            qnxt = Queue()
            max = 0
            while not q.isempty():
                x = q.dequeue()
                if x.key > max:
                    max = x.key
                
                if x.left != None:
                    qnxt.enqueue(x.left)
                if x.right != None:
                    qnxt.enqueue(x.right)

            res.append(max)   
            q = qnxt
        
        return res 
                

def has_path_with_sum(B,target):
    if B == None:
        return False
    else:
        if B.left == None:
            if B.right == None:
                if B.key == target:
                    return True
                else:
                    return False
            else:
                # Point simple droit (pas de fils gauche)
                return has_path_with_sum(B.right, target - B.key)
        else:
            # 2. CAS DU POINT SIMPLE GAUCHE (pas de fils droit)
            if B.right == None:
                return has_path_with_sum(B.left, target - B.key)
            else:
                # 3. CAS DU NŒUD COMPLET (2 fils) -> COURT-CIRCUIT STRICT
                res_g = has_path_with_sum(B.left, target - B.key)
                
                if res_g == True: 
                    return True
                else:     
                    return has_path_with_sum(B.right, target - B.key)

def is_perfectly_full(B):
