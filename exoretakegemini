        # On lance la vérification en miroir entre le côté gauche et le côté droit
        return help(B.left, B.right)

def help(B1, B2):
    if B1 == None and B2 == None:
        return True
    elif B1 == None and B2 != None:
        return False
    elif B1 != None and B2 == None:
        return False
    else:
        # 1. TEST LOCAL : Même clé ?
        if B1.key != B2.key:
            return False
        else:
            # 2. RECHERCHE EN MIROIR ET COURT-CIRCUIT
            # Premier croisement : Gauche de B1 avec Droite de B2
            res = help(B1.left, B2.right)
            
            if res:
                # Deuxième croisement : Droite de B1 avec Gauche de B2
                return help(B1.right, B2.left)
            else:
                return False
            

